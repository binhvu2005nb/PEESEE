<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="12dp">

            <!-- HEADER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="peesee"
                    android:textColor="#D71920"
                    android:textSize="27sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="35dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="⌕"
                    android:textColor="#20242B"
                    android:textSize="26sp" />

                <TextView
                    android:layout_width="35dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="♧"
                    android:textColor="#20242B"
                    android:textSize="22sp" />

                <TextView
                    android:layout_width="35dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="🛒"
                    android:textSize="20sp" />
            </LinearLayout>

            <!-- SEARCH -->
            <EditText
                android:id="@+id/edtSearch"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="8dp"
                android:background="#F0F2F6"
                android:hint="⌕  Tìm kiếm sản phẩm, thương hiệu..."
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnSearch"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="4dp"
                android:backgroundTint="#D71920"
                android:text="Tìm kiếm"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <!-- PROMOTION BANNER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="142dp"
                android:layout_marginTop="12dp"
                android:background="#FCEBEC"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.2"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="#F7A1A5"
                        android:padding="4dp"
                        android:text="Phụ kiện PC chính hãng"
                        android:textColor="#FFFFFF"
                        android:textSize="9sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Nâng cấp góc máy của bạn"
                        android:textColor="#171B22"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Hiệu năng tốt hơn – Trải nghiệm tuyệt vời hơn"
                        android:textColor="#707887"
                        android:textSize="9sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="#D71920"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:text="Mua ngay  →"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0.8"
                    android:gravity="center"
                    android:text="🎧&#10;⌨️&#10;🖱️"
                    android:textSize="31sp" />
            </LinearLayout>

            <!-- CATEGORIES -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="88dp"
                android:layout_marginTop="12dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="68dp"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:background="#FFF0F0"
                            android:gravity="center"
                            android:text="🖱️"
                            android:textSize="22sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Chuột Gaming"
                            android:textSize="10sp"
                            android:textColor="#30343B" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="68dp"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:background="#FFF0F0"
                            android:gravity="center"
                            android:text="⌨️"
                            android:textSize="22sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Bàn phím"
                            android:textSize="10sp"
                            android:textColor="#30343B" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="68dp"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:background="#FFF0F0"
                            android:gravity="center"
                            android:text="🎧"
                            android:textSize="22sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tai nghe"
                            android:textSize="10sp"
                            android:textColor="#30343B" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="68dp"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:background="#FFF0F0"
                            android:gravity="center"
                            android:text="🖥️"
                            android:textSize="22sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Màn hình"
                            android:textSize="10sp"
                            android:textColor="#30343B" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="68dp"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:background="#FFF0F0"
                            android:gravity="center"
                            android:text="▦"
                            android:textSize="24sp"
                            android:textColor="#D71920" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Xem tất cả"
                            android:textSize="10sp"
                            android:textColor="#30343B" />
                    </LinearLayout>
                </LinearLayout>
            </HorizontalScrollView>

            <!-- FLASH SALE TITLE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="⚡ Flash Sale"
                    android:textColor="#171B22"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Xem tất cả  →"
                    android:textColor="#D71920"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- FLASH SALE PRODUCTS -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="142dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="8dp"
                        android:background="#FFFFFF"
                        android:elevation="2dp"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="#D71920"
                            android:padding="3dp"
                            android:text="-20%"
                            android:textColor="#FFFFFF"
                            android:textSize="9sp" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="55dp"
                            android:gravity="center"
                            android:text="🖱️"
                            android:textSize="38sp" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Logitech G Pro X Superlight"
                            android:textColor="#30343B"
                            android:textSize="10sp"
                            android:maxLines="2" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="2.990.000đ"
                            android:textColor="#929BAD"
                            android:textSize="9sp" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="2.399.000đ"
                            android:textColor="#D71920"
                            android:textStyle="bold"
                            android:textSize="12sp" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="⭐ 4.9 (128)"
                            android:textColor="#707887"
                            android:textSize="9sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="142dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="8dp"
                        android:background="#FFFFFF"
                        android:elevation="2dp"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="#D71920"
                            android:padding="3dp"
                            android:text="-15%"
                            android:textColor="#FFFFFF"
                            android:textSize="9sp" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="55dp"
                            android:gravity="center"
                            android:text="⌨️"
                            android:textSize="38sp" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Keychron K8 Pro (RGB)"
                            android:textColor="#30343B"
                            android:textSize="10sp"
                            android:maxLines="2" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="2.690.000đ"
                            android:textColor="#929BAD"
                            android:textSize="9sp" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="2.289.000đ"
                            android:textColor="#D71920"
                            android:textStyle="bold"
                            android:textSize="12sp" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="⭐ 4.8 (96)"
                            android:textColor="#707887"
                            android:textSize="9sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="142dp"
                        android:layout_height="match_parent"
                        android:background="#FFFFFF"
                        android:elevation="2dp"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="#D71920"
                            android:padding="3dp"
                            android:text="-18%"
                            android:textColor="#FFFFFF"
                            android:textSize="9sp" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="55dp"
                            android:gravity="center"
                            android:text="🎧"
                            android:textSize="38sp" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="HyperX Cloud II"
                            android:textColor="#30343B"
                            android:textSize="10sp"
                            android:maxLines="2" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="2.190.000đ"
                            android:textColor="#929BAD"
                            android:textSize="9sp" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="1.869.000đ"
                            android:textColor="#D71920"
                            android:textStyle="bold"
                            android:textSize="12sp" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="⭐ 4.9 (203)"
                            android:textColor="#707887"
                            android:textSize="9sp" />
                    </LinearLayout>
                </LinearLayout>
            </HorizontalScrollView>

            <!-- BEST SELLERS -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:gravity="center_vertical"
                android:text="Sản phẩm bán chạy"
                android:textColor="#171B22"
                android:textSize="17sp"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="60dp"
                        android:layout_height="28dp"
                        android:background="#D71920"
                        android:gravity="center"
                        android:text="Tất cả"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp" />

                    <TextView
                        android:layout_width="60dp"
                        android:layout_height="28dp"
                        android:gravity="center"
                        android:text="Chuột"
                        android:textSize="10sp" />

                    <TextView
                        android:layout_width="75dp"
                        android:layout_height="28dp"
                        android:gravity="center"
                        android:text="Bàn phím"
                        android:textSize="10sp" />

                    <TextView
                        android:layout_width="70dp"
                        android:layout_height="28dp"
                        android:gravity="center"
                        android:text="Tai nghe"
                        android:textSize="10sp" />

                    <TextView
                        android:layout_width="70dp"
                        android:layout_height="28dp"
                        android:gravity="center"
                        android:text="Màn hình"
                        android:textSize="10sp" />
                </LinearLayout>
            </HorizontalScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:background="#F7F8FA"
                    android:padding="8dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🏆 Best Seller"
                        android:textColor="#D71920"
                        android:textSize="9sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="🖱️"
                        android:textSize="30sp" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Logitech G502 HERO"
                        android:textColor="#30343B"
                        android:textSize="10sp" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="1.299.000đ"
                        android:textColor="#D71920"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:background="#F7F8FA"
                    android:padding="8dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Sản phẩm nổi bật"
                        android:textColor="#30343B"
                        android:textSize="9sp" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="⌨️"
                        android:textSize="30sp" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Razer BlackWidow V3"
                        android:textColor="#30343B"
                        android:textSize="10sp" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="2.549.000đ"
                        android:textColor="#D71920"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- BUILD PC BANNER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="94dp"
                android:layout_marginTop="12dp"
                android:background="#FCEBEC"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.3"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Build góc PC trong mơ"
                        android:textColor="#30343B"
                        android:textStyle="bold"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Chọn phụ kiện phù hợp với phong cách của bạn."
                        android:textColor="#707887"
                        android:textSize="9sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="#FFFFFF"
                        android:padding="5dp"
                        android:text="Khám phá ngay  →"
                        android:textColor="#D71920"
                        android:textSize="9sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0.7"
                    android:gravity="center"
                    android:text="🖥️&#10;🎮"
                    android:textSize="29sp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- BOTTOM NAVIGATION -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:gravity="center"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⌂"
                android:textColor="#D71920"
                android:textSize="23sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Trang chủ"
                android:textColor="#D71920"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▦"
                android:textColor="#8993A4"
                android:textSize="22sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Danh mục"
                android:textColor="#8993A4"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🛒"
                android:textSize="20sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Giỏ hàng"
                android:textColor="#8993A4"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▤"
                android:textColor="#8993A4"
                android:textSize="22sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đơn hàng"
                android:textColor="#8993A4"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="♙"
                android:textColor="#8993A4"
                android:textSize="22sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cá nhân"
                android:textColor="#8993A4"
                android:textSize="9sp" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>